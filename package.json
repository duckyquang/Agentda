{
  "name": "agentda",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "chat": "tsx apps/cli/src/chat.ts",
    "canary": "tsx apps/cli/src/canary.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "daemon": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs apps/daemon/src/index.ts",
    "test:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --no-file-parallelism"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
